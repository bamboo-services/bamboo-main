# ============================================
# App
# ============================================
XLF_DEBUG=true
XLF_HOST=0.0.0.0
XLF_PORT=23333

# ============================================
# Database
# ============================================
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bamboo_main
DATABASE_PASS=bamboo_main
DATABASE_NAME=bamboo_main
DATABASE_PREFIX=bm_
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Shanghai

# ============================================
# Redis
# ============================================
NOSQL_DRIVER=redis
NOSQL_HOST=localhost
NOSQL_PORT=6379
NOSQL_PASS=
NOSQL_DATABASE=0
NOSQL_PREFIX=bm

# ============================================
# Snowflake
# ============================================
SNOWFLAKE_NODE_ID=1

# ============================================
# Mail (框架 xEmail 插件)
# ============================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=noreply@example.com
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=竹叶
# TLS 策略 (none/starttls/tls)，465 端口使用 tls
EMAIL_TLS=tls
# 业务配置：管理员邮箱（接收友链申请通知）
EMAIL_ADMIN_EMAIL=admin@example.com

# ============================================
# Screenshot（友链站点截图 · 无头浏览器）
# ============================================
# 截图服务总开关
SCREENSHOT_ENABLED=true
# 截图存储目录（相对进程工作目录；经 /screenshots 静态路由对外访问）
SCREENSHOT_DIR=data/screenshots
# Chrome/Chromium 可执行文件路径（留空自动探测；宿主机开发可留空）
#   注意：Docker 部署时必须为 /usr/bin/chromium（镜像内置）。若此处留空，
#   docker-compose 的 environment 已兜底覆盖，但脱离 compose 直接跑镜像需显式设置，
#   否则 rod 会触发自动下载与 alpine/musl 运行时不兼容的浏览器。
SCREENSHOT_CHROME_PATH=
# 外部 CDP 服务地址（留空则内置 spawn 浏览器子进程；Docker 可填 chromium 容器地址）
SCREENSHOT_CDP_URL=
# 单次截图超时（秒）
SCREENSHOT_TIMEOUT=30

# ============================================
# SSO
# ============================================
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_WELL_KNOWN_URI=
SSO_REDIRECT_URI=
SSO_ENDPOINT_AUTH_URI=
SSO_ENDPOINT_TOKEN_URI=
SSO_ENDPOINT_USERINFO_URI=
SSO_ENDPOINT_INTROSPECTION_URI=
SSO_ENDPOINT_REVOCATION_URI=
SSO_BUSINESS_CACHE=false
SSO_GRPC_HOST=
SSO_GRPC_PORT=
