# ============================================
# App
# ============================================
XLF_DEBUG=true
XLF_HOST=0.0.0.0
XLF_PORT=23333

# ============================================
# Database
# ============================================
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bamboo_main
DATABASE_PASS=bamboo_main
DATABASE_NAME=bamboo_main
DATABASE_PREFIX=bm_
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Shanghai

# ============================================
# Redis
# ============================================
NOSQL_DRIVER=redis
NOSQL_HOST=localhost
NOSQL_PORT=6379
NOSQL_PASS=
NOSQL_DATABASE=0
NOSQL_PREFIX=bm

# ============================================
# Snowflake
# ============================================
SNOWFLAKE_NODE_ID=1

# ============================================
# Mail (框架 xEmail 插件)
# ============================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=noreply@example.com
EMAIL_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=竹叶
# TLS 策略 (none/starttls/tls)，465 端口使用 tls
EMAIL_TLS=tls
# 外部邮件模板目录（相对进程工作目录，单二进制部署需随附该目录）
EMAIL_TEMPLATE_DIR=templates/mail
# 业务配置：管理员邮箱（接收友链申请通知）
EMAIL_ADMIN_EMAIL=admin@example.com

# ============================================
# SSO
# ============================================
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_WELL_KNOWN_URI=
SSO_REDIRECT_URI=
SSO_ENDPOINT_AUTH_URI=
SSO_ENDPOINT_TOKEN_URI=
SSO_ENDPOINT_USERINFO_URI=
SSO_ENDPOINT_INTROSPECTION_URI=
SSO_ENDPOINT_REVOCATION_URI=
SSO_BUSINESS_CACHE=false
SSO_GRPC_HOST=
SSO_GRPC_PORT=
